# Existing SchoolIMS database / Supabase values
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Keep Cloud Run concurrency below this value. A failed connection returns before
# the edge gateway timeout so clients receive the API's JSON/CORS error response.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
ALLOWED_ORIGINS=*

# PhonePe Payment Gateway v2 Standard Checkout for NexSyrus subscriptions.
# Keep these credentials on SchoolIMS Backend only.
PHONEPE_CLIENT_ID=REPLACE_WITH_PHONEPE_CLIENT_ID
PHONEPE_CLIENT_SECRET=REPLACE_WITH_PHONEPE_CLIENT_SECRET
# Server-only HMAC key for student login QR cards. Must be at least 32 bytes.
# Never put this value in the Expo app. The QR feature fails closed when unset.
LOGIN_QR_HMAC_SECRET=
LOGIN_QR_TTL_DAYS=365
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_REDIRECT_URL=https://YOUR_SCHOOL_API/api/v1/admin/subscription/phonepe/return
PHONEPE_CALLBACK_USERNAME=REPLACE_WITH_PHONEPE_CALLBACK_USERNAME
PHONEPE_CALLBACK_PASSWORD=REPLACE_WITH_PHONEPE_CALLBACK_PASSWORD

# Configure this URL in the PhonePe merchant dashboard:
# https://YOUR_SCHOOL_API/api/v1/admin/subscription/phonepe/callback

# ---------------------------------------------------------------------------
# Database backup worker (schoolims-db-backup Cloud Run Job)
# Consumed by jobs/backup only — never by the public API, mobile apps, or frontend.
# Store real secrets in Google Secret Manager. Do not commit values.
# ---------------------------------------------------------------------------
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres
# GCS_BACKUP_BUCKET=schoolims-db-backups-YOUR_PROJECT_ID
# GCP_PROJECT_ID=YOUR_PROJECT_ID
# BACKUP_ENCRYPTION_KEY=
# BACKUP_TYPE=daily
# ANOMALY_THRESHOLD_PERCENT=25
# STALE_BACKUP_HOURS=26
# ALERT_WEBHOOK_URL=
# BACKUP_DRY_RUN=false
# RESTORE_TEST_DATABASE_URL=postgresql://postgres:password@localhost:5439/schoolims_temp
