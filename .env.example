# Existing SchoolIMS database / Supabase values
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
ALLOWED_ORIGINS=*

# PhonePe Payment Gateway v2 Standard Checkout for NexSyrus subscriptions.
# Keep these credentials on SchoolIMS Backend only.
PHONEPE_CLIENT_ID=REPLACE_WITH_PHONEPE_CLIENT_ID
PHONEPE_CLIENT_SECRET=REPLACE_WITH_PHONEPE_CLIENT_SECRET
# Server-only HMAC key for student login QR cards. Must be at least 32 bytes.
# Never put this value in the Expo app. The QR feature fails closed when unset.
LOGIN_QR_HMAC_SECRET=
LOGIN_QR_TTL_DAYS=365
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_REDIRECT_URL=https://YOUR_SCHOOL_API/api/v1/admin/subscription/phonepe/return
PHONEPE_CALLBACK_USERNAME=REPLACE_WITH_PHONEPE_CALLBACK_USERNAME
PHONEPE_CALLBACK_PASSWORD=REPLACE_WITH_PHONEPE_CALLBACK_PASSWORD

# Configure this URL in the PhonePe merchant dashboard:
# https://YOUR_SCHOOL_API/api/v1/admin/subscription/phonepe/callback
