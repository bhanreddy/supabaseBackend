{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 30,
        "matchesPrefix": ["database/daily/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 84,
        "matchesPrefix": ["database/weekly/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["database/monthly/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["database/manual/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 30,
        "matchesPrefix": ["manifests/daily/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 84,
        "matchesPrefix": ["manifests/weekly/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["manifests/monthly/"]
      }
    },
    {
      "action": { "type": "Delete" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["manifests/manual/"]
      }
    },
    {
      "action": { "type": "AbortIncompleteMultipartUpload" },
      "condition": { "age": 1 }
    }
  ]
}
